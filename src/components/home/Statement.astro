---
/**
 * 首页主张：全站唯一的一号标题。
 * 不设小标签，主张自己就是标题。
 */
import Panel from '../glass/Panel.astro';
import { withBase } from '../../lib/paths';
import type { NavItem } from '../../site.config';

interface Props {
  lead: string;
  note: string;
  links: NavItem[];
  enterIndex?: number;
}

const { lead, note, links, enterIndex = 0 } = Astro.props;
---

<Panel thickness="regular" class="enter" style={`--enter-index: ${enterIndex}`}>
  <div class="statement">
    <h1 class="statement__lead">{lead}</h1>
    <p class="statement__note">{note}</p>
    <ul class="statement__links">
      {
        links.map((link) => (
          <li>
            <a href={withBase(link.href)}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Panel>

<style>
  .statement {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5);
  }

  .statement__lead {
    font-size: var(--fs-xl);
    max-width: 20ch;
  }

  .statement__note {
    color: var(--text-dim);
    max-width: 36ch;
  }

  .statement__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }

  @media (max-width: 720px) {
    .statement {
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
