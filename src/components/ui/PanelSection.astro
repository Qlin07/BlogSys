---
/**
 * 带标题的玻璃分区：首页与索引页的统一容器。
 *
 * 标题放在面板内部作为首行（而非浮在面板上方的装饰性小标签），
 * 与内容之间用发丝线分隔，这样"标题—内容"的关系是结构性的。
 */
import Panel from '../glass/Panel.astro';

interface Props {
  heading?: string;
  /** 无标题时用 aria-label 给分区一个可读名称 */
  label?: string;
  thickness?: 'thin' | 'regular' | 'thick';
  [key: string]: unknown;
}

const { heading, label, thickness = 'regular', ...rest } = Astro.props;
---

<Panel thickness={thickness} radius="panel" aria-label={heading ?? label} {...rest}>
  <div class="section">
    {heading && <h2 class="section__heading">{heading}</h2>}
    <div class="section__body">
      <slot />
    </div>
  </div>
</Panel>

<style>
  .section {
    display: flex;
    flex-direction: column;
  }

  .section__heading {
    font-size: var(--fs-md);
    font-weight: 500;
    letter-spacing: normal;
    color: var(--text-dim);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .section__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  @media (max-width: 720px) {
    .section__heading {
      padding: var(--space-3) var(--space-4);
    }

    .section__body {
      padding: var(--space-4);
    }
  }
</style>
