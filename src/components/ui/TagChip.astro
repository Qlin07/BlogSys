---
/**
 * 标签：只有一个圆角层级，无图标、无编号 —— 标签不是序列。
 */
interface Props {
  tag: string;
  count?: number;
}

const { tag, count } = Astro.props;
---

<a class="tag" href={`/tags/${tag}/`}>
  {tag}
  {count !== undefined && <span class="tag__count">{count}</span>}
</a>

<style>
  .tag {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    padding: 2px var(--space-2);
    border-radius: var(--radius-chip);
    background-color: var(--wash);
    font-size: var(--fs-sm);
    color: var(--text-dim);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .tag:hover {
    color: var(--text);
    background-color: var(--wash-strong);
  }

  .tag__count {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-dim);
  }
</style>
