---
/**
 * 站点外壳：底纹 substrate + 玻璃层 + head 注入。
 *
 * 全站唯一的非用户触发动效（首屏编排）在这里通过 .substrate / .enter 触发，
 * 见 theme/base.css。
 */
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';

import '../theme/tokens.css';
import '../theme/themes/light.css';
import '../theme/themes/dark.css';
import '../theme/backdrop.css';
import '../theme/base.css';
import '../theme/glass.css';

import siteConfig from '../site.config';
import { withBase } from '../lib/paths';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';

interface Props {
  /** 页面标题；首页不传则用站点标题 */
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, ogType = 'website', noindex = false } = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.site.title}` : siteConfig.site.title;
const pageDescription = description ?? siteConfig.site.description;

/**
 * 必须用 Astro 解析后的 site，而不是 siteConfig.site.url：
 * 部署在子路径时 astro.config.mjs 会改写 site，直接读配置会导致 canonical
 * 指向旧域名，而 sitemap 用的是新域名 —— 实测踩过这个不一致。
 */
const siteUrl = Astro.site ?? new URL(siteConfig.site.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// 背景媒体：只有配置了图片/视频、且当前页面在生效范围内时才开启
const bg = siteConfig.background;
const backdropOn =
  Boolean(bg.image ?? bg.video) && (bg.scope === 'all' || Astro.url.pathname === '/');

// 配置值不写进 CSS，而是在 html 上行内注入 CSS 变量：
// 这样 site.config.ts 始终是唯一数据源，主题文件保持静态。
const backdropStyle = backdropOn
  ? [
      `--backdrop-scrim-alpha:${bg.scrim}`,
      `--backdrop-blur:${bg.blur}px`,
      `--backdrop-position:${bg.position}`,
    ].join(';')
  : undefined;

// tone 取 auto 时，调性跟随明暗主题 —— 属性本身由下面的内联脚本在首绘前写入，
// 这里只留一个标记，告诉脚本"这个属性由你负责维护"。
const backdropToneAuto = backdropOn && bg.tone === 'auto';

// 在首次绘制前确定主题，消除闪白。
// 背景调性若设为 auto，必须在同一处一起定下来：否则会先按默认调性绘制一帧再跳变。
const themeInit = `(function(){var d=document.documentElement;var mode=${JSON.stringify(
  siteConfig.theme.default,
)};try{var s=localStorage.getItem('theme');if(s==='light'||s==='dark'||s==='system')mode=s;}catch(e){}var dark=mode==='dark'||(mode==='system'&&window.matchMedia('(prefers-color-scheme: dark)').matches);d.setAttribute('data-theme',dark?'dark':'light');d.setAttribute('data-theme-mode',mode);${
  backdropToneAuto ? "d.setAttribute('data-backdrop-tone',dark?'dark':'light');" : ''
}})();`;
---

<!doctype html>
<html
  lang={siteConfig.site.lang}
  data-backdrop={backdropOn ? 'on' : undefined}
  data-backdrop-tone={backdropOn && bg.tone !== 'auto' ? bg.tone : undefined}
  data-backdrop-auto={backdropToneAuto ? 'on' : undefined}
  style={backdropStyle}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      siteConfig.features.search && (
        <link rel="stylesheet" href={withBase('/pagefind/pagefind-ui.css')} />
      )
    }

    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.site.title}
      href={withBase('/rss.xml')}
    />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={siteConfig.site.locale} />
    <meta name="twitter:card" content="summary" />

    <script is:inline set:html={themeInit} />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到正文</a>

    <!-- 玻璃之所以是玻璃，因为它盖着东西 -->
    <div class="substrate" aria-hidden="true">
      {
        backdropOn && bg.image && (
          <img class="substrate__media" src={withBase(bg.image)} alt="" decoding="async" />
        )
      }
      {
        backdropOn && bg.video && (
          <video
            class="substrate__media substrate__video"
            src={withBase(bg.video)}
            poster={bg.image ? withBase(bg.image) : undefined}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
          />
        )
      }
      {backdropOn && <div class="substrate__scrim" />}
    </div>

    <SiteHeader />

    <main id="main" class="wrap page">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
