---
/**
 * 系列总览
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PanelSection from '../../components/ui/PanelSection.astro';
import { collectSeries, formatDate, getPosts, postHref } from '../../lib/posts';

const posts = await getPosts();
const series = collectSeries(posts);
---

<BaseLayout title="系列" description="按主题成组的文章，组内有先后顺序。">
  <div class="page-heading">
    <h1>系列</h1>
    <p>共 {series.length} 个系列。单个系列里的文章有先后顺序，按顺序读才连贯。</p>
  </div>

  {
    series.map((group) => (
      <PanelSection heading={group.name}>
        <ol class="series-list">
          {group.posts.map((post, index) => (
            <li class="series-item">
              <span class="series-item__index">{index + 1}</span>
              <span class="series-item__title">
                <a href={postHref(post)}>{post.data.title}</a>
              </span>
              <time class="series-item__date" datetime={formatDate(post.data.date)}>
                {formatDate(post.data.date)}
              </time>
            </li>
          ))}
        </ol>
        <a class="series-more" href={`/series/${group.name}/`}>读整个系列（{group.posts.length} 篇）</a>
      </PanelSection>
    ))
  }
</BaseLayout>

<style>
  .series-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .series-item {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: baseline;
  }

  .series-item__index,
  .series-item__date {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }

  .series-item__title a {
    color: var(--text);
    text-decoration: none;
  }

  .series-item__title a:hover {
    color: var(--signal);
  }

  .series-more {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-dim);
  }

  .series-more:hover {
    color: var(--signal);
  }

  @media (max-width: 720px) {
    .series-item {
      grid-template-columns: 1.25rem minmax(0, 1fr);
    }

    .series-item__date {
      grid-column: 2;
    }
  }
</style>
